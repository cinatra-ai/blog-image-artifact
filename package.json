{
  "name": "@cinatra-ai/blog-image-artifact",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    }
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "Blog Image",
    "roles": [
      "artifact-blog-image"
    ],
    "dependencies": [
      {
        "packageName": "@cinatra-ai/blog-image-matcher-skill",
        "kind": "skill",
        "role": "matcher",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required"
      }
    ],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      },
      "skills": {
        "matchers": [
          "@cinatra-ai/blog-image-matcher-skill:blog-image-matcher"
        ]
      },
      "matcherConfidenceThreshold": 0.7,
      "objectTypes": [
        {
          "type": "@cinatra-ai/blog-image-artifact:blog-image",
          "claim": "dedicated",
          "dispositions": {
            "projection": "artifact-safe",
            "pinnable": false,
            "snapshotPolicy": "none",
            "sensitivity": "normal"
          },
          "schema": {
            "type": "object",
            "properties": {
              "post": {
                "type": "string"
              },
              "placement": {
                "type": "string",
                "enum": [
                  "featured"
                ]
              }
            },
            "required": [
              "post",
              "placement"
            ],
            "additionalProperties": true
          }
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  }
}
